"┌ kersh · 3 sessions ──────────────────────────────────────────────────────────────────────────────┐"
"│  ID           STATE   HARNESS     MODE        GROUP      NAME           PROGRESS                 │"
"│> a1b2c3       running claude-code interactive -          triage                                  │"
"│  d4e5f6       held    codex       interactive acme       fixer          exit status 3            │"
"│ ┌ keys ────────────────────────────────────────────────────────────────────────────────────────┐ │"
"│ │sessions [list]                                a session's screen [attach]                    │ │"
"│ │ j, <down>  next session                        C-], q       back to the list                 │ │"
"│ │ k, <up>    previous session                    k, <up>      up a line                        │ │"
"│ │ <home>     first session                       j, <down>    down a line                      │ │"
"│ │ <end>      last session                        <prior>      up a page                        │ │"
"│ │ s          start a session                     <next>, SPC  down a page                      │ │"
"│ │ x          stop it and close its pane          <home>       the top                          │ │"
"└─│ r          resume it with a prompt             <end>        the bottom                       │─┘"
"┌ │ R          restart it on its conversation      a, RET       attach; C-] comes back           │─┐"
"│r│ a, RET     attach; C-] comes back                                                            │ │"
"│f│ i          type text into it                  prompts and the start form [editor, form]      │ │"
"│>│ d          remove an ended session             C-s        start, resume, send                │ │"
"│ │ v          watch its screen here               ESC        cancel                             │ │"
"│ │ g          read the sessions again             TAB        next field                         │ │"
"│ │ ?          this help                           <backtab>  previous field                     │ │"
"│ │ q          quit                                                                              │ │"
"│ │                                               ~/.config/kersh/keys.yml rebinds any key.      │ │"
"│ │                                               Any key closes this help.                      │ │"
"│ └──────────────────────────────────────────────────────────────────────────────────────────────┘ │"
"│                                                                                                  │"
"│                                                                                                  │"
"│                                                                                                  │"
"│                                                                                                  │"
"└──────────────────────────────────────────────────────────────────────────────────────────────────┘"
"s start  x stop  r resume  a, RET attach  v screen  ? help  q quit                                  "
