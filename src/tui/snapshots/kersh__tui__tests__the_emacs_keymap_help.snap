"┌ kersh · 3 sessions ──────────────────────────────────────────────────────────────────────────────┐"
"│  ID           STATE   HARNESS     MODE        GROUP      NAME           PROGRESS                 │"
"│> a1b2c3       running claude-code interactive -          triage                                  │"
"│  d4e5f6       held    codex       interactive acme       fixer          exit status 3            │"
"│ ┌ keys ────────────────────────────────────────────────────────────────────────────────────────┐ │"
"│ │sessions [list]                                a session's screen [attach]                    │ │"
"│ │ n, C-n, <down>  next session                   C-], q            back to the list            │ │"
"│ │ p, C-p, <up>    previous session               p, C-p, <up>      up a line                   │ │"
"│ │ M-<, <home>     first session                  n, C-n, <down>    down a line                 │ │"
"│ │ M->, <end>      last session                   M-v, <prior>      up a page                   │ │"
"│ │ s               start a session                C-v, SPC, <next>  down a page                 │ │"
"│ │ k               stop it and close its pane     M-<, <home>       the top                     │ │"
"└─│ r               resume it with a prompt        M->, <end>        the bottom                  │─┘"
"┌ │ R               restart it on its conversation RET, a            attach; C-] comes back      │─┐"
"│r│ RET, a          attach; C-] comes back                                                       │ │"
"│f│ i               type text into it             prompts and the start form [editor, form]      │ │"
"│>│ D               remove an ended session        C-c C-c, C-x #           start, resume, send  │ │"
"│ │ v               watch its screen here          C-x C-c, C-x k, C-c C-k  cancel               │ │"
"│ │ g               read the sessions again        TAB                      next field           │ │"
"│ │ ?               this help                      <backtab>                previous field       │ │"
"│ │ q, C-x C-c      quit                                                                         │ │"
"│ │                                               ~/.config/kersh/keys.yml rebinds any key.      │ │"
"│ │                                               Any key closes this help.                      │ │"
